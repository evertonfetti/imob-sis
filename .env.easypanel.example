# =====================================================================
# MODELO: os valores de senha/segredo abaixo são apenas exemplos. Gere os seus
# (comandos indicados em cada linha) e NÃO coloque segredos reais no repositório.
# Variáveis para colar na aba "Ambiente" do serviço Docker Compose (Easypanel)
# Troque "seudominio.com.br" pelo seu domínio. Não use aspas.
# =====================================================================

# --- Banco de dados -----------------------------------------------------
# Só letras e números (sem @ : / # ?), pois entra dentro da URL do banco.
# Gere outra com:  openssl rand -hex 16
POSTGRES_PASSWORD=troque_por_uma_senha_so_com_letras_e_numeros_123

# --- Segurança ----------------------------------------------------------
# Mínimo 32 caracteres. Gere outro com:  openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres

# Opcional, mas recomendado: chave que criptografa o token do WhatsApp no banco. Gere com: openssl rand -base64 48
# Se não definir, usa o JWT_ACCESS_SECRET (trocá-lo depois obriga a reconectar o WhatsApp).
# ENCRYPTION_KEY=troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres

# --- Endereços públicos (sem barra no final) ----------------------------
# Painel administrativo
ADMIN_URL=https://painel.seudominio.com.br
# API (o painel e o site falam com ela)
API_PUBLIC_URL=https://api.seudominio.com.br
# Site público
SITE_URL=https://www.seudominio.com.br

# --- Primeiro acesso ----------------------------------------------------
# Usuário administrador criado na primeira subida (só se o e-mail não existir).
# Depois de entrar, troque a senha e apague SEED_ADMIN_PASSWORD daqui.
SEED_ADMIN_EMAIL=admin@seudominio.com.br
SEED_ADMIN_PASSWORD=TroqueEssaSenha#2026
# Nome que aparece no painel e no site (pode editar depois em "Empresa e filiais")
SEED_COMPANY_NAME=Sua Imobiliária

# --- Opcional: fotos em S3 / Cloudflare R2 / MinIO ----------------------
# Sem estas linhas, as fotos ficam no volume "uploads" (faça backup dele).
# Exemplo para Cloudflare R2:
# S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=imob-media
# S3_ACCESS_KEY=sua-access-key
# S3_SECRET_KEY=sua-secret-key
# S3_PUBLIC_URL=https://fotos.seudominio.com.br
