# =====================================================================
# Servidor de LICENÇAS (Bloco 11 / SaaS) — infraestrutura só sua, do dono da plataforma.
# Use com docker-compose.license.yml. NÃO confunda com o .env.easypanel.example (esse é do cliente).
# Valores abaixo são exemplos. Gere os seus e NÃO coloque segredos reais no repositório.
# =====================================================================

# --- Banco de dados (separado do banco de qualquer cliente) -------------
# Só letras e números. Gere com: openssl rand -hex 16
LICENSE_POSTGRES_PASSWORD=troque_por_uma_senha_so_com_letras_e_numeros_123

# --- Segurança ------------------------------------------------------------
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
LICENSE_JWT_ACCESS_SECRET=troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres

# --- Endereços públicos (sem barra no final) -------------------------------
# Painel master (onde você gerencia clientes, planos e licenças)
LICENSE_PANEL_URL=https://licencas.suaplataforma.com.br
# API de licenças (o painel master e as instalações dos clientes falam com ela)
LICENSE_API_PUBLIC_URL=https://licencas-api.suaplataforma.com.br

# --- Primeiro acesso --------------------------------------------------------
# Funcionário criado na primeira subida (só se o e-mail não existir).
# Depois de entrar, cadastre os demais e considere apagar SEED_STAFF_PASSWORD daqui.
SEED_STAFF_EMAIL=voce@suaplataforma.com.br
SEED_STAFF_PASSWORD=TroqueEssaSenha#2026
SEED_STAFF_NAME=Seu nome
