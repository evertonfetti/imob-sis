# Banco
DATABASE_URL="postgresql://imob:imob_dev@localhost:5432/imob"
TEST_DATABASE_URL="postgresql://imob:imob_dev@localhost:5432/imob_test"

# API
API_PORT=3333
API_PUBLIC_URL="http://localhost:3333"
SITE_URL="http://localhost:3000"
# PUBLIC_COMPANY_ID=   # opcional: qual empresa o site público exibe (padrão: a mais antiga)
ADMIN_URL="http://localhost:5173"
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+chars"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30

# Redis (fila de processamento de mídia). Opcional: sem ele, o processamento roda em linha.
# REDIS_URL="redis://localhost:6379"

# Storage de mídia. Sem S3_* definido, usa disco local (LOCAL_STORAGE_DIR).
# Para S3 / Cloudflare R2 / MinIO, descomente e preencha:
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="auto"
# S3_BUCKET="imob-media"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_PUBLIC_URL="http://localhost:9000/imob-media"

# Seed (primeiro administrador)
SEED_ADMIN_EMAIL="admin@imobiliaria.local"
SEED_ADMIN_PASSWORD="Trocar@123456"

# --- Site (apps/website) ---
# NEXT_PUBLIC_API_URL="http://localhost:3333/api/v1"   # embutida no build; usada pelo navegador
# API_INTERNAL_URL="http://localhost:3333/api/v1"      # usada pelo servidor do site (rede interna)

# --- Produção (docker-compose.yml / Easypanel) ---
# POSTGRES_PASSWORD=
# ADMIN_URL="https://painel.seudominio.com.br"
# API_PUBLIC_URL="https://api.seudominio.com.br"   # sem barra final
# SITE_URL="https://www.seudominio.com.br"
