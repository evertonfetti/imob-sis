// Bloco 1 — Fundação. Todas as entidades de negócio carregam companyId (pronto para SaaS).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum OwnerType {
  PERSON
  COMPANY
}

enum PropertyPurpose {
  SALE
  RENT
  SALE_AND_RENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
  TOUR_360
  DOCUMENT
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum LeadSource {
  SITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  GOOGLE
  PORTAL
  REFERRAL
  PHONE
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum StageType {
  OPEN
  WON
  LOST
}

enum LeadDistribution {
  MANUAL
  ROUND_ROBIN
}

enum TaskType {
  CALL
  WHATSAPP
  EMAIL
  VISIT
  FOLLOW_UP
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum IntegrationProvider {
  WHATSAPP
  META_CAPI
  META_APP
  AI_IMAGE
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MarketingEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SocialProvider {
  FACEBOOK_PAGE
  INSTAGRAM
}

enum SocialAccountStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum SocialPostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
  CANCELLED
}

enum SocialTargetStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum VisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProposalStatus {
  DRAFT
  SENT
  UNDER_REVIEW
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProposalParty {
  BUYER
  OWNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id               String           @id @default(uuid(7))
  name             String
  tradeName        String?
  document         String?
  creci            String?
  email            String?
  phone            String?
  whatsapp         String?
  website          String?
  logoUrl          String?
  primaryColor     String?
  secondaryColor   String?
  status           CompanyStatus    @default(ACTIVE)
  propertySeq      Int              @default(0)
  leadDistribution LeadDistribution @default(MANUAL)
  // Limites de alertas e automações comerciais (JSON; o que faltar usa o padrão do sistema).
  intelligenceSettings Json?
  // Marca d'água nas fotos: { enabled, position, opacity, scale, margin }. A logo enviada fica em logoKey.
  watermarkSettings Json?
  watermarkRevision Int     @default(0)
  logoKey           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]
  audits   AuditLog[]

  owners             Owner[]
  propertyTypes      PropertyType[]
  features           Feature[]
  properties         Property[]
  media              PropertyMedia[]
  customers          Customer[]
  leads              Lead[]
  whatsappClicks     WhatsAppClick[]
  pipelines          Pipeline[]
  leadStageHistories LeadStageHistory[]
  timelineEvents     TimelineEvent[]
  tasks              Task[]
  integrations       Integration[]
  conversations      Conversation[]
  messages           Message[]
  marketingEvents    MarketingEvent[]
  socialAccounts     SocialAccount[]
  socialApps         SocialApp[]
  mediaGenerations   MediaGeneration[]
  socialPosts        SocialPost[]

  visits    Visit[]
  proposals Proposal[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid(7))
  companyId String
  name      String
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  properties Property[]

  @@index([companyId])
  @@map("branches")
}

model Role {
  id        String   @id @default(uuid(7))
  companyId String
  key       String
  name      String
  system    Boolean  @default(true)
  createdAt DateTime @default(now())

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([companyId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7))
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid(7))
  companyId    String
  branchId     String?
  roleId       String
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  creci        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company            Company              @relation(fields: [companyId], references: [id])
  branch             Branch?              @relation(fields: [branchId], references: [id])
  role               Role                 @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  properties         Property[]
  leads              Lead[]
  lastLeadAssignedAt DateTime?
  assignedTasks      Task[]               @relation("TaskAssignee")
  visits             Visit[]              @relation("VisitBroker")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  companyId String
  userId    String?
  entity    String
  entityId  String?
  action    String
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@map("audit_logs")
}

// ---------- Bloco 2 — Imóveis ----------

model Owner {
  id        String    @id @default(uuid(7))
  companyId String
  type      OwnerType @default(PERSON)
  name      String
  document  String?
  email     String?
  phone     String?
  whatsapp  String?
  address   String?
  city      String?
  state     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  properties Property[]
  proposals  Proposal[]

  @@index([companyId, name])
  @@map("owners")
}

model PropertyType {
  id        String   @id @default(uuid(7))
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id])
  properties Property[]

  @@unique([companyId, name])
  @@map("property_types")
}

model Feature {
  id        String  @id @default(uuid(7))
  companyId String
  name      String
  slug      String
  icon      String?
  category  String?
  active    Boolean @default(true)

  company    Company           @relation(fields: [companyId], references: [id])
  properties PropertyFeature[]

  @@unique([companyId, slug])
  @@map("features")
}

model Property {
  id        String  @id @default(uuid(7))
  companyId String
  branchId  String?

  code String
  slug String

  title            String
  shortDescription String?
  description      String?

  purpose PropertyPurpose
  typeId  String
  subtype String?
  status  PropertyStatus  @default(DRAFT)

  ownerId  String?
  brokerId String?

  salePrice               Decimal? @db.Decimal(14, 2)
  rentPrice               Decimal? @db.Decimal(14, 2)
  condominiumFee          Decimal? @db.Decimal(14, 2)
  propertyTax             Decimal? @db.Decimal(14, 2)
  minimumNegotiationPrice Decimal? @db.Decimal(14, 2)

  bedrooms      Int?
  suites        Int?
  bathrooms     Int?
  parkingSpaces Int?

  totalArea  Decimal? @db.Decimal(12, 2)
  usefulArea Decimal? @db.Decimal(12, 2)
  builtArea  Decimal? @db.Decimal(12, 2)
  landArea   Decimal? @db.Decimal(12, 2)

  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  latitude     Float?
  longitude    Float?

  showExactAddress Boolean   @default(false)
  featured         Boolean   @default(false)
  published        Boolean   @default(false)
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  type           PropertyType      @relation(fields: [typeId], references: [id])
  owner          Owner?            @relation(fields: [ownerId], references: [id])
  broker         User?             @relation(fields: [brokerId], references: [id])
  features       PropertyFeature[]
  media          PropertyMedia[]
  leads          Lead[]
  whatsappClicks WhatsAppClick[]
  tasks          Task[]
  socialPosts    SocialPost[]
  visits         Visit[]
  proposals      Proposal[]

  @@unique([companyId, code])
  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([companyId, published, city])
  @@index([ownerId])
  @@index([brokerId])
  @@map("properties")
}

model PropertyFeature {
  propertyId String
  featureId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
  @@map("property_features")
}

// ---------- Bloco 3 — Fotos e mídias ----------
// O arquivo original NUNCA é substituído: versões processadas (e, no futuro, geradas por IA) ficam em chaves separadas.
// Guardamos as chaves de storage (não URLs): trocar de CDN/domínio não exige migração de dados.

model PropertyMedia {
  id         String @id @default(uuid(7))
  companyId  String
  propertyId String

  type        MediaType   @default(IMAGE)
  status      MediaStatus @default(PENDING)
  filename    String?
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?

  originalKey  String
  processedKey String?
  thumbnailKey String?
  // JPEG recortado para o Instagram (que não aceita WebP e limita a proporção). Gerado sob demanda.
  socialKey    String?

  caption    String?
  position   Int     @default(0)
  isCover    Boolean @default(false)
  aiModified Boolean @default(false)
  // Versão de IA aprovada e publicada (null = a foto original). O original nunca é substituído.
  activeGenerationId String?
  renderedGenerationId String?
  // Revisão da marca d'água aplicada na versão publicada (null = sem marca).
  watermarkRevision Int?

  processingError String?
  createdAt       DateTime @default(now())

  company     Company           @relation(fields: [companyId], references: [id])
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  generations MediaGeneration[]

  @@index([propertyId, position])
  @@index([companyId])
  @@map("property_media")
}

// ---------- Bloco 4 — Leads vindos do site ----------
// Base mínima para o formulário público. O funil (estágios, kanban, timeline, tarefas) é o Bloco 5.

model Customer {
  id        String   @id @default(uuid(7))
  companyId String
  name      String
  email     String?
  phone     String?
  whatsapp  String?
  document  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  leads           Lead[]
  conversations   Conversation[]
  marketingEvents MarketingEvent[]
  proposals       Proposal[]

  @@index([companyId, phone])
  @@index([companyId, email])
  @@map("customers")
}

model Lead {
  id         String  @id @default(uuid(7))
  companyId  String
  customerId String
  propertyId String?
  brokerId   String?

  source LeadSource @default(MANUAL)
  status LeadStatus @default(NEW)
  score  Int        @default(0)
  // Quando o score foi calculado pela última vez (null = ainda não calculado; o agendador preenche).
  scoreUpdatedAt DateTime?

  budgetMin        Decimal?         @db.Decimal(14, 2)
  budgetMax        Decimal?         @db.Decimal(14, 2)
  purpose          PropertyPurpose?
  city             String?
  neighborhood     String?
  bedrooms         Int?
  purchaseTimeline String?
  notes            String?
  consentAt        DateTime?

  stageId        String?
  stageEnteredAt DateTime  @default(now())
  lostReason     String?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company            @relation(fields: [companyId], references: [id])
  customer        Customer           @relation(fields: [customerId], references: [id])
  property        Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker          User?              @relation(fields: [brokerId], references: [id])
  stage           PipelineStage?     @relation(fields: [stageId], references: [id])
  attribution     LeadAttribution?
  timeline        TimelineEvent[]
  stageHistory    LeadStageHistory[]
  tasks           Task[]
  conversations   Conversation[]
  marketingEvents MarketingEvent[]
  visits          Visit[]
  proposals       Proposal[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, stageId])
  @@index([companyId, brokerId])
  @@index([companyId, score])
  @@index([customerId])
  @@index([propertyId])
  @@map("leads")
}

// Gravada na criação do lead: não depende de o CRM recuperar isso depois.
model LeadAttribution {
  leadId String @id

  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  fbclid           String?
  fbc              String?
  fbp              String?
  gclid            String?
  landingPage      String?
  referrer         String?
  campaignId       String?
  adsetId          String?
  adId             String?
  // Dados do navegador guardados na criação: o evento de conversão pode ser enviado dias depois.
  clientIp         String?
  clientUserAgent  String?
  eventId          String?
  pageUrl          String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_attributions")
}

model WhatsAppClick {
  id         String  @id @default(uuid(7))
  companyId  String
  propertyId String?
  sessionId  String?
  visitorId  String?

  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  fbclid           String?
  fbc              String?
  fbp              String?
  gclid            String?
  landingPage      String?
  referrer         String?
  leadId           String?
  clientIp         String?
  clientUserAgent  String?
  eventId          String?
  pageUrl          String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([propertyId])
  @@map("whatsapp_clicks")
}

// ---------- Bloco 5 — CRM ----------

model Pipeline {
  id        String  @id @default(uuid(7))
  companyId String
  name      String
  active    Boolean @default(true)

  company Company         @relation(fields: [companyId], references: [id])
  stages  PipelineStage[]

  @@index([companyId])
  @@map("pipelines")
}

model PipelineStage {
  id         String    @id @default(uuid(7))
  pipelineId String
  name       String
  position   Int
  color      String    @default("#8a8578")
  type       StageType @default(OPEN)
  // Entrar neste estágio dispara o evento lead.qualified (usado pelo Marketing/CAPI).
  qualifies  Boolean   @default(false)
  // Evento da Meta (CAPI) disparado quando um lead entra na etapa: QualifiedLead | Schedule | Purchase.
  metaEvent  String?
  // Papel fixo na automação comercial (VISIT_SCHEDULED, VISIT_DONE, PROPOSAL, NEGOTIATION, WON). Independe do nome da etapa.
  systemKey  String?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

// Histórico de movimentação: base para tempo por estágio, conversão e gargalos.
model LeadStageHistory {
  id          String   @id @default(uuid(7))
  companyId   String
  leadId      String
  fromStageId String?
  toStageId   String
  userId      String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([companyId, toStageId])
  @@map("lead_stage_history")
}

model TimelineEvent {
  id          String   @id @default(uuid(7))
  companyId   String
  leadId      String
  type        String
  entityId    String?
  userId      String?
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("timeline_events")
}

model Task {
  id             String       @id @default(uuid(7))
  companyId      String
  leadId         String?
  propertyId     String?
  assignedUserId String?
  createdById    String?
  type           TaskType     @default(FOLLOW_UP)
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  // Origem automática (ex.: visit:<id>:confirm), para cancelar a tarefa quando a visita muda.
  ref            String?
  status         TaskStatus   @default(OPEN)
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  company      Company   @relation(fields: [companyId], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation("TaskAssignee", fields: [assignedUserId], references: [id])

  @@index([companyId, status, dueAt])
  @@index([assignedUserId, status])
  @@index([leadId])
  @@map("tasks")
}

// ---------- Bloco 6 — WhatsApp ----------

// Credenciais de integrações. Segredos ficam criptografados (AES-256-GCM) em `secrets`; nunca voltam pela API.
model Integration {
  id          String              @id @default(uuid(7))
  companyId   String
  provider    IntegrationProvider
  // Identificador do lado do provedor. No WhatsApp: phone_number_id (roteia o webhook para a empresa certa).
  externalId  String?
  verifyToken String?
  config      Json                @default("{}")
  secrets     String
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, provider])
  @@unique([provider, externalId])
  @@unique([provider, verifyToken])
  @@map("integrations")
}

model Conversation {
  id                 String              @id @default(uuid(7))
  companyId          String
  leadId             String?
  customerId         String?
  channel            ConversationChannel @default(WHATSAPP)
  // Identificador do contato no canal (WhatsApp: wa_id, só dígitos).
  externalId         String
  contactName        String?
  status             ConversationStatus  @default(OPEN)
  unreadCount        Int                 @default(0)
  lastMessageAt      DateTime?
  lastInboundAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([companyId, channel, externalId])
  @@index([companyId, lastMessageAt])
  @@index([leadId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid(7))
  companyId      String
  conversationId String
  direction      MessageDirection
  // ID da mensagem no provedor (WhatsApp: wamid). Único por empresa: torna o webhook idempotente.
  externalId     String?
  type           String           @default("text")
  content        String?
  mediaId        String?
  mediaMime      String?
  mediaKey       String?
  // Parâmetros do envio (ex.: modelo aprovado + variáveis), usados para reenviar mensagens que falharam.
  payload        Json?
  status         MessageStatus    @default(RECEIVED)
  error          String?
  sentByUserId   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  company      Company      @relation(fields: [companyId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------- Bloco 7 — Marketing / Meta CAPI ----------
// Histórico de tudo que o sistema tenta enviar à Meta: permite descobrir rápido quando ela rejeita um evento.
model MarketingEvent {
  id        String               @id @default(uuid(7))
  companyId String
  leadId    String?
  provider  String               @default("META_CAPI")
  eventName String
  // Mesmo ID usado no Pixel do navegador (deduplicação).
  eventId   String
  status    MarketingEventStatus @default(PENDING)
  payload   Json?
  response  Json?
  error     String?
  attempts  Int                  @default(0)
  createdAt DateTime             @default(now())
  sentAt    DateTime?

  company    Company   @relation(fields: [companyId], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  @@unique([companyId, provider, eventId])
  @@index([companyId, createdAt])
  @@index([leadId, eventName])
  @@map("marketing_events")
}

// ---------- Bloco 8 — Publicação em redes sociais ----------

// Página do Facebook ou conta do Instagram conectada via login com o Facebook.
// O token de acesso (da Página) fica criptografado em `secrets` e nunca volta pela API.
// Aplicativos da Meta (login com o Facebook) cadastrados pela empresa; pode haver vários.
model SocialApp {
  id          String   @id @default(uuid(7))
  companyId   String
  name        String
  appId       String
  // { appSecret } criptografado (AES-256-GCM).
  secrets     String
  // Dono do app (quem cadastrou). Privado por padrão; `shared` libera para a equipe.
  createdById String?
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id])
  accounts SocialAccount[]

  @@unique([companyId, createdById, appId])
  @@map("social_apps")
}

model SocialAccount {
  id            String              @id @default(uuid(7))
  companyId     String
  provider      SocialProvider
  externalId    String
  name          String
  username      String?
  pictureUrl    String?
  // Instagram: Página do Facebook à qual a conta está ligada.
  pageId        String?
  status        SocialAccountStatus @default(PENDING)
  secrets       String
  connectedById String?
  // App da Meta pelo qual a conta foi conectada (null = app padrão do servidor ou app removido).
  socialAppId   String?
  // Privada por padrão: só quem conectou usa. Compartilhada = toda a equipe pode publicar nela.
  shared        Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company            @relation(fields: [companyId], references: [id])
  app     SocialApp?         @relation(fields: [socialAppId], references: [id], onDelete: SetNull)
  targets SocialPostTarget[]

  @@unique([companyId, connectedById, provider, externalId])
  @@index([companyId, status])
  @@map("social_accounts")
}

model SocialPost {
  id          String           @id @default(uuid(7))
  companyId   String
  propertyId  String
  createdById String?
  caption     String
  mediaIds    String[]
  status      SocialPostStatus @default(SCHEDULED)
  scheduledAt DateTime
  // Trava de processamento: evita que duas instâncias publiquem a mesma postagem.
  lockedAt    DateTime?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company  Company            @relation(fields: [companyId], references: [id])
  property Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  targets  SocialPostTarget[]

  @@index([status, scheduledAt])
  @@index([companyId, scheduledAt])
  @@index([propertyId])
  @@map("social_posts")
}

// Cada rede publica (e falha) de forma independente.
model SocialPostTarget {
  id            String             @id @default(uuid(7))
  postId        String
  accountId     String
  status        SocialTargetStatus @default(PENDING)
  externalId    String?
  permalink     String?
  error         String?
  retryable     Boolean            @default(false)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?
  publishedAt   DateTime?

  post    SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
  @@index([status, nextAttemptAt])
  @@map("social_post_targets")
}

// ---------- Bloco 9 — Comercial ----------

model Visit {
  id              String      @id @default(uuid(7))
  companyId       String
  leadId          String
  propertyId      String
  brokerId        String
  scheduledAt     DateTime
  durationMinutes Int         @default(60)
  status          VisitStatus @default(SCHEDULED)
  notes           String?
  feedback        String?
  cancelReason    String?
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])
  broker   User     @relation("VisitBroker", fields: [brokerId], references: [id])

  @@index([companyId, scheduledAt])
  @@index([brokerId, scheduledAt])
  @@index([leadId])
  @@index([propertyId])
  @@map("visits")
}

model Proposal {
  id              String         @id @default(uuid(7))
  companyId       String
  leadId          String
  propertyId      String
  buyerId         String
  ownerId         String?
  createdById     String?
  askingPrice     Decimal        @db.Decimal(14, 2)
  proposedPrice   Decimal        @db.Decimal(14, 2)
  downPayment     Decimal?       @db.Decimal(14, 2)
  financingAmount Decimal?       @db.Decimal(14, 2)
  conditions      String?
  status          ProposalStatus @default(DRAFT)
  validUntil      DateTime?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company   Company            @relation(fields: [companyId], references: [id])
  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property  Property           @relation(fields: [propertyId], references: [id])
  buyer     Customer           @relation(fields: [buyerId], references: [id])
  owner     Owner?             @relation(fields: [ownerId], references: [id])
  revisions ProposalRevision[]

  @@index([companyId, status])
  @@index([leadId])
  @@index([propertyId, status])
  @@index([status, validUntil])
  @@map("proposals")
}

// Histórico da negociação: cada valor proposto (pelo comprador ou pelo proprietário) fica registrado.
model ProposalRevision {
  id          String        @id @default(uuid(7))
  proposalId  String
  amount      Decimal       @db.Decimal(14, 2)
  conditions  String?
  party       ProposalParty @default(BUYER)
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_revisions")
}

// ---------- Bloco 8 — IA de imagens ----------
enum AiOperation {
  ENHANCE
  LIGHTING
  REMOVE_OBJECT
  REMOVE_FURNITURE
  VIRTUAL_STAGE
  SKY_REPLACEMENT
}

enum AiGenerationStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

// Cada edição por IA é uma versão nova (original → geração 1 → geração 2…). O usuário aprova qual publicar.
model MediaGeneration {
  id         String @id @default(uuid(7))
  companyId  String
  propertyId String
  mediaId    String
  userId     String?
  // Geração usada como ponto de partida (null = a foto original).
  parentId   String?

  operation AiOperation
  provider  String
  model     String?
  prompt    String?
  options   Json?

  inputKey  String
  outputKey String?
  thumbKey  String?

  status     AiGenerationStatus @default(QUEUED)
  error      String?
  // Estimativa em USD (tabela do provedor); 0 quando o processamento é local.
  cost       Decimal?           @db.Decimal(10, 4)
  durationMs Int?
  approvedAt DateTime?
  createdAt  DateTime           @default(now())

  company Company       @relation(fields: [companyId], references: [id])
  media   PropertyMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([companyId, createdAt])
  @@map("media_generations")
}
