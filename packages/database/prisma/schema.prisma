// Bloco 1 — Fundação. Todas as entidades de negócio carregam companyId (pronto para SaaS).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum OwnerType {
  PERSON
  COMPANY
}

enum PropertyPurpose {
  SALE
  RENT
  SALE_AND_RENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
  TOUR_360
  DOCUMENT
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id             String        @id @default(uuid(7))
  name           String
  tradeName      String?
  document       String?
  creci          String?
  email          String?
  phone          String?
  whatsapp       String?
  website        String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  status         CompanyStatus @default(ACTIVE)
  propertySeq    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branches Branch[]
  users    User[]
  roles    Role[]
  audits   AuditLog[]

  owners        Owner[]
  propertyTypes PropertyType[]
  features      Feature[]
  properties    Property[]
  media         PropertyMedia[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid(7))
  companyId String
  name      String
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  properties Property[]

  @@index([companyId])
  @@map("branches")
}

model Role {
  id        String   @id @default(uuid(7))
  companyId String
  key       String
  name      String
  system    Boolean  @default(true)
  createdAt DateTime @default(now())

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([companyId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7))
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid(7))
  companyId    String
  branchId     String?
  roleId       String
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  creci        String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company       Company              @relation(fields: [companyId], references: [id])
  branch        Branch?              @relation(fields: [branchId], references: [id])
  role          Role                 @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  properties    Property[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  companyId String
  userId    String?
  entity    String
  entityId  String?
  action    String
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@map("audit_logs")
}

// ---------- Bloco 2 — Imóveis ----------

model Owner {
  id        String    @id @default(uuid(7))
  companyId String
  type      OwnerType @default(PERSON)
  name      String
  document  String?
  email     String?
  phone     String?
  whatsapp  String?
  address   String?
  city      String?
  state     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  properties Property[]

  @@index([companyId, name])
  @@map("owners")
}

model PropertyType {
  id        String   @id @default(uuid(7))
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id])
  properties Property[]

  @@unique([companyId, name])
  @@map("property_types")
}

model Feature {
  id        String  @id @default(uuid(7))
  companyId String
  name      String
  slug      String
  icon      String?
  category  String?
  active    Boolean @default(true)

  company    Company           @relation(fields: [companyId], references: [id])
  properties PropertyFeature[]

  @@unique([companyId, slug])
  @@map("features")
}

model Property {
  id        String  @id @default(uuid(7))
  companyId String
  branchId  String?

  code String
  slug String

  title            String
  shortDescription String?
  description      String?

  purpose PropertyPurpose
  typeId  String
  subtype String?
  status  PropertyStatus  @default(DRAFT)

  ownerId  String?
  brokerId String?

  salePrice               Decimal? @db.Decimal(14, 2)
  rentPrice               Decimal? @db.Decimal(14, 2)
  condominiumFee          Decimal? @db.Decimal(14, 2)
  propertyTax             Decimal? @db.Decimal(14, 2)
  minimumNegotiationPrice Decimal? @db.Decimal(14, 2)

  bedrooms      Int?
  suites        Int?
  bathrooms     Int?
  parkingSpaces Int?

  totalArea  Decimal? @db.Decimal(12, 2)
  usefulArea Decimal? @db.Decimal(12, 2)
  builtArea  Decimal? @db.Decimal(12, 2)
  landArea   Decimal? @db.Decimal(12, 2)

  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  latitude     Float?
  longitude    Float?

  showExactAddress Boolean   @default(false)
  featured         Boolean   @default(false)
  published        Boolean   @default(false)
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id])
  branch   Branch?           @relation(fields: [branchId], references: [id])
  type     PropertyType      @relation(fields: [typeId], references: [id])
  owner    Owner?            @relation(fields: [ownerId], references: [id])
  broker   User?             @relation(fields: [brokerId], references: [id])
  features PropertyFeature[]
  media    PropertyMedia[]

  @@unique([companyId, code])
  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([companyId, published, city])
  @@index([ownerId])
  @@index([brokerId])
  @@map("properties")
}

model PropertyFeature {
  propertyId String
  featureId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  feature  Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([propertyId, featureId])
  @@map("property_features")
}

// ---------- Bloco 3 — Fotos e mídias ----------
// O arquivo original NUNCA é substituído: versões processadas (e, no futuro, geradas por IA) ficam em chaves separadas.
// Guardamos as chaves de storage (não URLs): trocar de CDN/domínio não exige migração de dados.

model PropertyMedia {
  id         String @id @default(uuid(7))
  companyId  String
  propertyId String

  type        MediaType   @default(IMAGE)
  status      MediaStatus @default(PENDING)
  filename    String?
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?

  originalKey  String
  processedKey String?
  thumbnailKey String?

  caption    String?
  position   Int     @default(0)
  isCover    Boolean @default(false)
  aiModified Boolean @default(false)

  processingError String?
  createdAt       DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@index([companyId])
  @@map("property_media")
}
